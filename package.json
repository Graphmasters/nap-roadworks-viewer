{
  "name": "@graphmasters/nap-roadworks-viewer",
  "version": "0.1.0",
  "description": "Inspect DATEX II roadworks and road-closure feeds in the browser: XML/profile checks, map, OSM road lookup, lane comparison and passability analysis.",
  "keywords": [
    "datex2",
    "datexii",
    "napcore",
    "national-access-point",
    "roadworks",
    "road-closure",
    "openstreetmap",
    "maplibre"
  ],
  "license": "Apache-2.0",
  "author": "Graphmasters",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Graphmasters/nap-roadworks-viewer.git"
  },
  "homepage": "https://graphmasters.github.io/nap-roadworks-viewer/",
  "bugs": "https://github.com/Graphmasters/nap-roadworks-viewer/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "NOTICE",
    "ATTRIBUTION.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "build:app": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.18.0 || ^24.11.0 || >=26.0.0",
      "onFail": "error"
    }
  },
  "dependencies": {
    "lane-status-viewer": "0.1.2",
    "osm-lanes": "0.3.0",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "~2.0.5",
    "@types/geojson": "7946.0.16",
    "@types/node": "~26.6.6",
    "maplibre-gl": "~6.17.0",
    "pbf": "~4.0.2",
    "tsup": "~9.0.0",
    "typescript": "~5.9.3",
    "vite": "~7.3.7",
    "vitest": "~5.1.0",
    "xmllint-wasm": "5.3.0"
  }
}
